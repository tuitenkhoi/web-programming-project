# Sao chép file này thành .env rồi điền giá trị thật (KHÔNG commit file .env)
PORT=5000

# MySQL (XAMPP mặc định: user root, mật khẩu rỗng, cổng 3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moc_coffee


# Chuỗi bí mật tự đặt, dài ÍT NHẤT 32 ký tự. Thiếu hoặc quá ngắn thì server không khởi động.
JWT_SECRET=
# Thời hạn đăng nhập (tùy chọn)
JWT_EXPIRES_IN=8h

# ----- Tùy chọn (không điền cũng chạy) -----
# Chạy sau Nginx/hosting: đặt 1 để lấy đúng IP khách (cho giới hạn đăng nhập sai / chống spam)
# TRUST_PROXY=1
# Chỉ cho các domain này gọi API, cách nhau bằng dấu phẩy. Bỏ trống = cho phép tất cả
# CORS_ORIGIN=http://localhost:5500
# Số kết nối MySQL tối đa trong pool (mặc định 10)
# DB_POOL_SIZE=10
# Thời gian (ms) nhớ kết quả kiểm tra tài khoản admin; 0 = tắt (mặc định 10000)
# AUTH_CACHE_MS=10000

# ----- Gửi email (kích hoạt tài khoản, quên mật khẩu) -----
# Bỏ trống SMTP_HOST thì server chỉ in nội dung mail ra console ("[MAIL TRAP]") để test, không gửi thật.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Mộc Coffee <no-reply@moccoffee.vn>"
# Địa chỉ gốc của website, dùng để tạo link trong email
APP_URL=http://localhost:5000

# ----- Trợ lý AI (tùy chọn, chưa dùng ở P1) -----
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
